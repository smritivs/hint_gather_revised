// -*- mode:c++ -*-
//
// HINT.GATHER -- RISC-V custom-0 instruction format.
//
// Role
//   Defines the `HintGatherOp` ISA format used to decode opcode 0x0B
//   (custom-0, QUADRANT == 0x3 && OPCODE5 == 0x02) into a static
//   instruction class that:
//
//     * reads rs1 and rs2,
//     * writes NO architectural register (it never mentions the Rd
//       operand, so numDestRegs() == 0 -- docs/DESIGN.md 1.1: rd = x0),
//     * touches NO memory operand (it never mentions the Mem operand, so
//       isLoad()/isStore() are false and it can never enter the LSQ --
//       docs/DESIGN.md 1.3.3),
//     * carries op_class No_OpClass, so it needs no functional unit,
//     * is flagged IsHintGather, which is what routes it to the Prefetch
//       Hint Queue in IEW::dispatchInsts(),
//     * executes as an exact NOP, which is what makes the AtomicSimpleCPU
//       correctness gate pass by construction (docs/DESIGN.md 1.3.4).
//
//   It also overrides StaticInst::hintGatherFields() to hand the decoded
//   funct3/funct7 payload to the (ISA-agnostic) PHQ.
//
// Normative spec
//   ../../../../../docs/DESIGN.md section 1.1 (encoding) and 1.3
//   (architectural semantics).
//
// Encoding (docs/DESIGN.md 1.1)
//   .insn r 0x0b, <funct3>, <funct7>, x0, <rs1>, <rs2>
//
//     funct3 = bits<14:12>      funct7 = bits<31:25>
//       bit 0 (mach bit 12) VARIANT   0 = value form, 1 = chase form
//       bit 1 (mach bit 13) LEVEL     0 = L1D,        1 = L2
//       bit 2 (mach bit 14) DROP      0 = keep,       1 = droppable
//
//       bits 1:0 (mach 26:25) SHIFT   element size = 1 << SHIFT
//       bits 4:2 (mach 29:27) FANOUT  issue FANOUT + 1 prefetches
//       bits 6:5 (mach 31:30) reserved, must be 0 -- IGNORED, never faults
//
// Placement
//   Copied into <gem5-root>/src/arch/riscv/isa/formats/hint_gather.isa by
//   ../../../../../apply_phq.py, which also adds the single
//   `##include "hint_gather.isa"` line to formats/formats.isa and the
//   `0x02:` case to decoder.isa. This is a NEW file: it is copied verbatim
//   and never edited, so it carries no BEGIN/END HINT.GATHER markers.
//
// API-verification policy
//   Modelled directly on formats/basic.isa (BasicDeclare / BasicConstructor
//   / BasicDecode / BasicExecute) and formats/standard.isa (FenceExecute's
//   register-free generateDisassembly), both read verbatim out of
//   gem5 v23 and confirmed byte-identical in gem5 develop. The bitfield
//   macros FUNCT3, FUNCT7, RS1 and RS2 are emitted by the ISA parser into
//   both the decoder output and the exec output -- ImmConstructor uses
//   IMM12 in decoder output and FenceExecute uses FUNCT3/PRED/SUCC in exec
//   output, so both usages below have precedent in tree.

////////////////////////////////////////////////////////////////////
//
// HINT.GATHER declaration template.
//
// Differs from BasicDeclare only by the hintGatherFields() override and
// the five decoded payload members.
//
def template HintGatherDeclare {{
    //
    // Static instruction class for "%(mnemonic)s".
    //
    // docs/DESIGN.md 1.4: this instruction allocates a ROB entry and
    // nothing else. It has zero destination registers and is not a memory
    // reference, so rename allocates no physical register and the LSQ never
    // sees it.
    //
    class %(class_name)s : public %(base_class)s
    {
      private:
        %(reg_idx_arr_decl)s;

        /* Decoded funct3/funct7 payload (docs/DESIGN.md 1.1). */
        uint8_t hgVariant   = 0;
        uint8_t hgLevel     = 0;
        uint8_t hgDroppable = 0;
        uint8_t hgShift     = 0;
        uint8_t hgFanout    = 0;

      public:
        /// Constructor.
        %(class_name)s(ExtMachInst machInst);

        Fault execute(ExecContext *, trace::InstRecord *) const override;

        std::string generateDisassembly(
                Addr pc, const loader::SymbolTable *symtab) const override;

        /*
         * ISA-agnostic accessor consumed by gem5::o3::PrefetchHintQueue.
         * The base declaration is added to src/cpu/static_inst.hh by
         * apply_phq.py (region HINT_GATHER_STATIC_INST_ACCESSORS).
         */
        bool
        hintGatherFields(StaticInst::HintGatherFields &out) const override
        {
            out.variant   = hgVariant;
            out.level     = hgLevel;
            out.droppable = hgDroppable;
            out.shift     = hgShift;
            out.fanout    = hgFanout;
            return true;
        }
    };
}};

////////////////////////////////////////////////////////////////////
//
// HINT.GATHER constructor template.
//
// %(constructor)s emits the `flags[...] = true;` lines for every flag
// passed in opt_flags, which is how IsHintGather gets set.
//
def template HintGatherConstructor {{
    %(class_name)s::%(class_name)s(ExtMachInst machInst)
        : %(base_class)s("%(mnemonic)s", machInst, %(op_class)s)
    {
        %(set_reg_idx_arr)s;
        %(constructor)s;

        /*
         * docs/DESIGN.md 1.1. FUNCT3 is machInst<14:12> and FUNCT7 is
         * machInst<31:25>; both are bitfield macros emitted by the ISA
         * parser (see bitfields.isa).
         *
         * funct7<6:5> is reserved and must be zero. We deliberately do NOT
         * check it: docs/DESIGN.md 1.3.2 says HINT.GATHER never raises an
         * exception, so a malformed encoding degrades to a hint we may
         * ignore, never to an illegal-instruction fault.
         */
        hgVariant   = (uint8_t)((FUNCT3 >> 0) & 0x1);
        hgLevel     = (uint8_t)((FUNCT3 >> 1) & 0x1);
        hgDroppable = (uint8_t)((FUNCT3 >> 2) & 0x1);
        hgShift     = (uint8_t)((FUNCT7 >> 0) & 0x3);
        hgFanout    = (uint8_t)((FUNCT7 >> 2) & 0x7);
    }
}};

////////////////////////////////////////////////////////////////////
//
// HINT.GATHER execute template.
//
// The code body is an exact NOP (docs/DESIGN.md 1.3.4). Under
// AtomicSimpleCPU this is literally all that happens, which is what makes
// the architectural-equivalence gate pass by construction. Under the O3
// CPU execute() is never called at all: IEW marks the instruction
// issued/executed/canCommit at dispatch and hands it to the PHQ.
//
// generateDisassembly is register-free in the sense that it prints the
// architectural register numbers straight out of the encoding rather than
// going through registerName(RegId), because RISC-V operands.isa maps x0 to
// an invalid RegId and we must not assume rs1/rs2 produced valid RegIds.
//
def template HintGatherExecute {{
    Fault
    %(class_name)s::execute(ExecContext *xc,
        trace::InstRecord *traceData) const
    {
        %(op_decl)s;
        %(op_rd)s;
        %(code)s;
        %(op_wb)s;
        return NoFault;
    }

    std::string
    %(class_name)s::generateDisassembly(Addr pc,
            const loader::SymbolTable *symtab) const
    {
        std::stringstream ss;
        ss << mnemonic
           << (hgVariant ? ".c" : "")
           << " x" << (unsigned)RS1
           << ", x" << (unsigned)RS2
           << "   # level=" << (hgLevel ? "L2C" : "L1D")
           << " drop=" << (unsigned)hgDroppable
           << " elem=" << (unsigned)(1u << hgShift)
           << "B fanout=" << (unsigned)(hgFanout + 1);
        return ss.str();
    }
}};

////////////////////////////////////////////////////////////////////
//
// The format itself.
//
// base_class is 'RiscvStaticInst' rather than 'RegOp' on purpose: RegOp's
// generateDisassembly prints a destination register, and we have none.
//
// The caller must pass IsHintGather and No_OpClass in opt_flags; see the
// decoder.isa region that apply_phq.py inserts.
//
def format HintGatherOp(code, *opt_flags) {{
    iop = InstObjParams(name, Name, 'RiscvStaticInst', code, opt_flags)
    header_output  = HintGatherDeclare.subst(iop)
    decoder_output = HintGatherConstructor.subst(iop)
    decode_block   = BasicDecode.subst(iop)
    exec_output    = HintGatherExecute.subst(iop)
}};
